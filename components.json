    {
      "id": "atmosphere-base",
      "name": "Atmosphere CFW",
      "kind": "github_release",
      "repo": "Atmosphere-NX/Atmosphere",
      "tag": "1.12.2",
      "asset_glob": "atmosphere-1.12.2-*.zip",
      "protected": true,
      "extract_mode": "zip_tree",
      "exclude_paths": [
        "hbmenu.nro",
        "atmosphere/reboot_payload.bin",
        "switch/haze.nro",
        "switch/daybreak.nro",
        "switch/reboot_to_payload.nro"
      ],
      "keep_switch_defaults": false
    },
    {
      "id": "hekate-base",
      "name": "Hekate & Nyx Support Files",
      "kind": "github_release",
      "repo": "CTCaer/hekate",
      "tag": "v6.5.5",
      "asset_glob": "hekate_ctcaer_*_Nyx_*.zip",
      "protected": true,
      "extract_mode": "zip_selected",
      "include_paths": [
        "bootloader/sys/libsys_lp0.bso",
        "bootloader/sys/libsys_minerva.bso",
        "bootloader/sys/res.pak",
        "bootloader/sys/thk.bin",
