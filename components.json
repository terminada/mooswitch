      "exclude_paths": [
        "payload.bin",
        "bootloader/*",
        "bootloader/sys/*",
        "switch/.overlays/Status-Monitor-Overlay.ovl"
      ],
      "rename_map": {
        "switch/Benchmark-Toolbox.nro": "switch/Benchmark-Toolbox/Benchmark-Toolbox.nro"
      }
    },
    {
      "id": "cowmmc-core",
